+    def __init__(self, arch: Optional[hosts.Arch] = None):
+        # Select the host executable architecture independently from the
+        # machine running the build. CI may cross-build any supported host.
+        if arch is None:
+            selected = os.environ.get('TERMUX_NDK_HOST_ARCH', 'aarch64').lower()
+            arch = {
+                'aarch64': hosts.Arch.AARCH64,
+                'arm64': hosts.Arch.AARCH64,
+                'x86_64': hosts.Arch.X86_64,
+                'amd64': hosts.Arch.X86_64,
+                'armv7': hosts.Arch.ARM,
+                'arm': hosts.Arch.ARM,
+            }.get(selected)
+            if arch is None:
+                raise RuntimeError('Unsupported TERMUX_NDK_HOST_ARCH: {}'.format(selected))
+        machine = platform.machine().lower()
+        build_arch = {
+            'x86_64': hosts.Arch.X86_64,
+            'amd64': hosts.Arch.X86_64,
+            'aarch64': hosts.Arch.AARCH64,
+            'arm64': hosts.Arch.AARCH64,
+            'armv7l': hosts.Arch.ARM,
+            'armv8l': hosts.Arch.ARM,
+            'arm': hosts.Arch.ARM,
+        }.get(machine)
+        if build_arch is None:
+            raise RuntimeError('Unsupported build machine architecture: {}'.format(machine))
+        super().__init__(arch=arch, is_cross_compiling=(arch != build_arch))
 
